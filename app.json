{
  "expo": {
    "name": "Shumitomo",
    "slug": "shumitomo",
    "version": "0.1.0",
    "scheme": "shumitomo",
    "userInterfaceStyle": "light",
    "web": {
      "output": "single",
      "favicon": "./app/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./app/assets/android-icon-foreground.png",
        "backgroundImage": "./app/assets/android-icon-background.png",
        "monochromeImage": "./app/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "icon": "./app/assets/icon.png"
  }
}
