# Server-only. Copy using npm run setup:secrets; never commit .env.edge.local.
# SUPABASE_URL / SUPABASE_SECRET_KEYS are provided by the hosted Edge runtime.
INTEGRATION_SECRET_KEY_NAME=default
INTEGRATION_TOKEN_KEY=
INTEGRATION_WORKER_KEY=
APP_ALLOWED_ORIGINS=http://localhost:8081
INTEGRATION_CALLBACK_URL=
STEAM_WEB_API_KEY=
# Supabase custom:steam adapter; generate a separate secret and share it with the DB/auth configuration owner.
STEAM_LOGIN_CLIENT_ID=shumitomo-steam
STEAM_LOGIN_CLIENT_SECRET=
DISCORD_LINK_CLIENT_ID=
DISCORD_LINK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam cadence/retries are fixed in steamSyncPolicy by the approved spec.
# Discord cadence remains undecided; leave all three empty to disable periodic Discord sync.
DISCORD_SYNC_INTERVAL_MS=
DISCORD_SYNC_RETRY_MS=
DISCORD_SYNC_STALE_MS=

# Q-30: disabled until the team chooses a transport and configures FCM/APNs.
NOTIFICATION_TRANSPORT=disabled
EXPO_ACCESS_TOKEN=
