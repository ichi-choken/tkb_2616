{
  "name": "shumitomo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3.0 <25 || >=26"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.auth.json",
    "test:auth": "npm --prefix packages/integrations run build && node --test tests/*.test.ts tests/*.test.mjs",
    "test:integrations": "npm --prefix packages/integrations test",
    "test": "npm run test:auth && npm run test:integrations",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm run typecheck:frontend && npm test && npm run check:edge && npm run build:web",
    "setup": "npm ci && npm --prefix packages/integrations ci",
    "check:edge": "deno check --frozen --config supabase/functions/deno.json supabase/functions/integration-api/index.ts supabase/functions/integration-sync/index.ts supabase/functions/igdb-search/index.ts supabase/functions/notification-delivery/index.ts supabase/functions/steam-auth/index.ts supabase/functions/steam-trust/index.ts",
    "build:native": "expo export --platform ios --platform android --output-dir dist-native",
    "doctor:config": "node --env-file-if-exists=.env --env-file-if-exists=.env.edge.local scripts/check-config.mjs",
    "setup:secrets": "node scripts/create-local-secrets.mjs",
    "typecheck:frontend": "tsc --noEmit --project app/tsconfig.json",
    "start:local": "npm --prefix packages/integrations run build && npm run build:web && node scripts/serve-local.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dela-gothic-one": "0.4.1",
    "@expo-google-fonts/zen-kaku-gothic-new": "0.4.2",
    "@expo/metro-runtime": "58.0.15",
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "2.118.0",
    "expo": "58.0.19",
    "expo-auth-session": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.15",
    "expo-device": "58.0.5",
    "expo-font": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.14",
    "expo-notifications": "58.1.6",
    "expo-router": "58.0.26",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "deno": "2.9.6",
    "typescript": "6.0.3"
  }
}
