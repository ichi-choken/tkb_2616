{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/auth/**/*.ts",
    "src/lib/**/*.ts",
    "src/notifications/**/*.ts",
    "src/app/auth/**/*.tsx",
    "src/app/dev/**/*.tsx",
    "src/app/_layout.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-native"
  ]
}
