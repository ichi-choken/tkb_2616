# Public configuration only. Server secrets belong in Supabase Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: enable the developer-only verification screen in a preview build.
EXPO_PUBLIC_ENABLE_AUTH_DIAGNOSTICS=false
EXPO_PUBLIC_ENABLE_PUSH=false
# Optional: the public web address, used for recruitment links shared from the native app (the web app uses its own address).
EXPO_PUBLIC_APP_URL=
